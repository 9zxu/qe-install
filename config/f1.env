QE_VERSION="${QE_VERSION:-7.6}"
QE_GIT_URL="${QE_GIT_URL:-https://gitlab.com/QEF/q-e.git}"
QE_GIT_SHA="${QE_GIT_SHA:-9f93ddec427d2b9a45bb72d828c6d324f62fcabd}"

QE_MODULES="${QE_MODULES:-intel/2024_01_46}"
QE_MODULES_INIT="${QE_MODULES_INIT:-/etc/profile.d/modules.sh}"

QE_CC="${QE_CC:-icx}"
QE_F90="${QE_F90:-ifort}"
QE_MPIF90="${QE_MPIF90:-mpiifort}"

# alternative: -xHost; rejected because the binary would depend on the node that compiled it
QE_ARCH_FLAGS="${QE_ARCH_FLAGS:--xCORE-AVX512}"
QE_FFLAGS="${QE_FFLAGS:--O2 -assume byterecl -g -traceback -diag-disable=10448 ${QE_ARCH_FLAGS}}"
QE_CFLAGS="${QE_CFLAGS:--O3 ${QE_ARCH_FLAGS}}"

QE_CONFIGURE_OPTS="${QE_CONFIGURE_OPTS:---enable-parallel --enable-openmp --with-scalapack=intel}"
# alternative: all; rejected because it also builds EPW, GWW and every plugin
QE_TARGETS="${QE_TARGETS:-pw ph pp neb cp hp}"
